# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=sk-...
# Fast, cheap, non-reasoning model is best for a 60-second task. gpt-5-mini also works (slower).
OPENAI_MODEL=gpt-4.1-mini
# Only used for reasoning models (gpt-5*, o*): minimal | low | medium
OPENAI_REASONING_EFFORT=
# Server-side spend guard (estimate from token usage). Also set a hard limit in the OpenAI dashboard.
BUDGET_USD=9.50
# Price per 1M tokens for the model above, used for the spend estimate (check openai.com/api/pricing)
PRICE_IN_PER_M=0.40
PRICE_OUT_PER_M=1.60
RATE_PER_MIN=30

# --- Live traffic (optional). Free key from developer.tomtom.com (no credit card). Without it the Roads layer
# shows NWS storm reports, neighbor posts and a link to 511 instead.
TOMTOM_API_KEY=
# Monthly caps kept below TomTom's free tier (2,500 incident requests, 200,000 tiles):
# TOMTOM_INCIDENT_MONTHLY=2300
# TOMTOM_TILE_MONTHLY=190000
# TOMTOM_INCIDENT_CACHE_S=1500
